# Soft-launch / production (Netlify / Vercel)
# Mock Builder auto-enables on NETLIFY / VERCEL / Lambda (no local Python).
# Set explicitly if you want to force it:
SNIPER_USE_MOCK_BUILDER=1

# Optional: hide or point ADMIN nav (desk is local for soft launch)
# NEXT_PUBLIC_DESK_URL=http://localhost:3001

# StockAnalysis company blurbs (headline = core business, entry = thesis)
# Defaults to ~/Documents/StockAnalysis/NoamShit/company_blurbs.json
# Falls back to data/company_blurbs.json in this repo
# SNIPER_BLURBS_FILE=/absolute/path/to/company_blurbs.json

# Desk app only (SNIPER-DESK) — never commit real secrets
# ADMIN_PASSWORD=generate-a-long-random-password
# SNIPER_DATA_DIR=/absolute/path/to/SNIPER/data
# NEXT_PUBLIC_SNIPER_PUBLIC_URL=https://your-app.vercel.app

# Financial Modeling Prep (live quotes) — REQUIRED on Netlify for current market prices.
# Without this, /api/stocks and /api/quotes serve seed snapshots only.
# FMP_API_KEY=

# Phase 2 — optional user accounts (guest localStorage always works)
# Production: Supabase Auth magic link + sniper_portfolios table (see supabase/schema.sql)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Force local OTP file store (data/.runtime/user_accounts.json) even in production soft-launch:
# SNIPER_ACCOUNTS_DEV=1
# SNIPER_ACCOUNTS_BACKEND=local|supabase|off
# NEXT_PUBLIC_ACCOUNTS=1
