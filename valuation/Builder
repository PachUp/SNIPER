def famous_picks_json(
    all_stocks: dict[str, Stock],
    manual_eligible: tuple[str, ...],
) -> dict:
    """Machine-readable famous shortlist for the SNIPER website."""
    picks = []
    for sym in FAMOUS_STOCKS:
        s = all_stocks.get(sym)
        if not s:
            picks.append(
                {
                    "symbol": sym,
                    "eligible": False,
                    "reason": "not_in_fv",
                }
            )
            continue
        eligible = sym in manual_eligible
        picks.append(
            {
                "symbol": sym,
                "eligible": eligible,
                "beta": round(s.beta, 3),
                "upside_pct": round(s.upside_pct, 1) if s.upside_pct is not None else None,
                "price": round(s.price, 2) if s.price is not None else None,
                "fair_value": round(s.fair_value, 2) if s.fair_value is not None else None,
                "industry": s.industry,
                "sector": s.sector or None,
                "sharpe_ratio": round(s.sharpe_ratio, 3) if s.sharpe_ratio is not None else None,
                "reason": None if eligible else "below_min_upside_or_disqualified",
            }
        )
