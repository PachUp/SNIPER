        "min_manual_picks": MIN_MANUAL_PICKS,
        "max_manual_picks": MAX_MANUAL_PICKS,
        "famous_min_upside_pct": FAMOUS_MIN_UPSIDE_PCT,
        "eligible": [p["symbol"] for p in picks if p.get("eligible")],
        "picks": picks,
        "built_at": datetime.now(timezone.utc).isoformat(),
    }


def load_fv_stocks(
    fv_dir: Path,
    *,
    symbol_to_sector: dict[str, str],
    industry_to_sector: dict[str, str],
) -> dict[str, Stock]:
    out: dict[str, Stock] = {}
    for fp in sorted(fv_dir.glob("*_industry_fair_values.json")):
        try:
            data = json.loads(fp.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            continue
        if not isinstance(data, list):
            continue
        for block in data:
            industry = (block.get("meta") or {}).get("group_name") or ""
            for v in block.get("valuations") or []:
                if not isinstance(v, dict) or v.get("error"):
                    continue
                sym = v.get("symbol")
                if not sym:
                    continue
                meta = v.get("meta") or {}
                beta = meta.get("beta")
                if not isinstance(beta, (int, float)) or not math.isfinite(float(beta)):
                    continue
                bd = v.get("blended_detail") or {}
                price = bd.get("stock_price")
                fv = v.get("blended_fair_value")
                upside = None
                if isinstance(price, (int, float)) and isinstance(fv, (int, float)) and price > 0:
                    upside = (float(fv) / float(price) - 1.0) * 100.0
                row = Stock(
                    symbol=str(sym),
                    beta=float(beta),
                    upside_pct=upside,
                    price=float(price) if isinstance(price, (int, float)) else None,
                    fair_value=float(fv) if isinstance(fv, (int, float)) else None,
                    industry=str(industry),
                    sector=resolve_sector(str(sym), str(industry), symbol_to_sector, industry_to_sector),
                    famous=False,
                    high_upside=upside is not None and upside >= MIN_UPSIDE_PCT,
                )
                prev = out.get(row.symbol)
                if prev is None or (row.upside_pct or -1e9) > (prev.upside_pct or -1e9):
                    out[row.symbol] = row
    return out


def build_universe(all_stocks: dict[str, Stock], famous_eligible: tuple[str, ...]) -> list[Stock]:
    picked: dict[str, Stock] = {}
    famous_set = set(famous_eligible)
    for sym in famous_eligible:
        if sym in all_stocks:
            s = all_stocks[sym]
            picked[sym] = Stock(
                symbol=s.symbol,
                beta=s.beta,
                upside_pct=s.upside_pct,
                price=s.price,
                fair_value=s.fair_value,
                industry=s.industry,
                sector=s.sector,
                famous=True,
                high_upside=s.high_upside,
                sharpe_ratio=s.sharpe_ratio,
            )
    for s in all_stocks.values():
        if is_symbol_disqualified(s.symbol):
            continue
        if s.high_upside:
            prev = picked.get(s.symbol)
            flags = Stock(
                symbol=s.symbol,
                beta=s.beta,
                upside_pct=s.upside_pct,
                price=s.price,
                fair_value=s.fair_value,
                industry=s.industry,
                sector=s.sector,
                famous=s.symbol in famous_set,
                high_upside=True,
                sharpe_ratio=s.sharpe_ratio,
            )
            if prev is None or (flags.upside_pct or -1e9) > (prev.upside_pct or -1e9):
                picked[s.symbol] = flags
    return sorted(picked.values(), key=lambda x: x.symbol)


def _feasible_beta_range(betas: np.ndarray) -> tuple[float, float]:
    return float(np.min(betas)), float(np.max(betas))


def _normalize_symbols(symbols: list[str]) -> list[str]:
    out: list[str] = []
    seen: set[str] = set()
    for raw in symbols:
        sym = raw.strip().upper()
        if not sym or sym in seen:
            continue
        seen.add(sym)
        out.append(sym)
    return out


def _meets_min_upside(s: Stock, min_pct: float = MIN_UPSIDE_PCT) -> bool:
    return s.upside_pct is not None and float(s.upside_pct) >= min_pct


def select_diversified_fillers(
    candidates: list[Stock],
    *,
    count: int,
    target_avg_beta: float,
    used_industries: set[str],
    used_sectors: Optional[set[str]] = None,
) -> list[Stock]:
    """Greedy pick: admin replacements first, then upside, industry/sector spread and β fit."""
    chosen: list[Stock] = []
    pool = list(candidates)
    industries = set(used_industries)
    sectors = set(used_sectors or ())
    chosen_syms: set[str] = set()

    def pick_replacement_for_slot() -> Optional[Stock]:
        """Prefer admin replacement symbols (e.g. AA → MPC) when still available."""
        best: Optional[tuple[float, Stock]] = None
        for _disq, repl in SYMBOL_OVERRIDES.items():
            if not repl or repl in chosen_syms:
                continue
            for c in pool:
                if c.symbol != repl or not _meets_min_upside(c):
                    continue
                score = float(c.upside_pct or 0)
                if best is None or score > best[0]:
                    best = (score, c)
        return best[1] if best else None

    for _slot in range(count):
        if not pool:
            break
        repl_pick = pick_replacement_for_slot()
        if repl_pick is not None:
            pick = repl_pick
        else:
            ideal_beta = target_avg_beta
            best: Optional[tuple[float, Stock]] = None
            for c in pool:
                if not _meets_min_upside(c):
                    continue
                upside_score = float(c.upside_pct or 0) / 100.0
                beta_penalty = abs(c.beta - ideal_beta) * 0.12
                industry_bonus = 0.15 if c.industry not in industries else 0.0
                sector_bonus = 0.12 if c.sector and c.sector not in sectors else 0.0
                score = upside_score - beta_penalty + industry_bonus + sector_bonus
                if best is None or score > best[0]:
                    best = (score, c)
            if best is None:
                break
            pick = best[1]
        chosen.append(pick)
        chosen_syms.add(pick.symbol)
        pool.remove(pick)
        industries.add(pick.industry)
        if pick.sector:
            sectors.add(pick.sector)
    return chosen


def _beta_within_switch_band(stock_beta: float, reference_beta: float, tolerance: float) -> bool:
    return abs(float(stock_beta) - float(reference_beta)) <= tolerance + 1e-9


def _pick_best_alternative(
    candidates: list[Stock],
    reference_beta: Optional[float],
) -> Optional[Stock]:
    if not candidates:
        return None
    if reference_beta is not None:
        candidates.sort(key=lambda s: (-float(s.upside_pct or 0), abs(s.beta - reference_beta)))
    else:
        candidates.sort(key=lambda s: -float(s.upside_pct or 0))
    return candidates[0]


def best_replacement_alternative(
    universe: list[Stock],
    *,
    industry: str,
    sector: str,
    exclude: set[str],
    reference_beta: Optional[float] = None,
    beta_tolerance: float = BETA_SWITCH_TOLERANCE,
    min_upside_pct: float = 0.0,
) -> Optional[tuple[Stock, str]]:
    """
    Find replacement with upside ≥ ``min_upside_pct``: same industry first, then same sector.
    Replacement β must be within ``beta_tolerance`` of ``reference_beta``.
    Returns ``(stock, "industry"|"sector")`` or ``None``.
    """
    def _eligible(s: Stock) -> bool:
        if s.symbol in exclude or not _meets_min_upside(s, min_upside_pct):
            return False
        if reference_beta is not None and not _beta_within_switch_band(s.beta, reference_beta, beta_tolerance):
            return False
        return True

    industry_alts = [s for s in universe if _eligible(s) and s.industry == industry]
    pick = _pick_best_alternative(industry_alts, reference_beta)
    if pick is not None:
        return pick, "industry"

    if sector:
        sector_alts = [
            s for s in universe if _eligible(s) and s.sector == sector and s.industry != industry
        ]
        pick = _pick_best_alternative(sector_alts, reference_beta)
        if pick is not None:
            return pick, "sector"
        sector_alts = [s for s in universe if _eligible(s) and s.sector == sector]
        pick = _pick_best_alternative(sector_alts, reference_beta)
        if pick is not None:
            return pick, "sector"
    return None


def suggest_industry_switches(
    universe: list[Stock],
    holdings: list[dict],
    portfolio_symbols: set[str],
) -> list[dict]:
    """For each negative-upside holding, suggest industry then sector replacement."""
    by_sym = {s.symbol: s for s in universe}
    out: list[dict] = []
    for h in holdings:
        up = h.get("upside_pct")
        if up is None or up >= 0:
            continue
        src = by_sym.get(h["symbol"])
        sector = h.get("sector") or (src.sector if src else "")
        repl = best_replacement_alternative(
            universe,
            industry=h["industry"],
            sector=sector,
            exclude=portfolio_symbols,
            reference_beta=h.get("beta"),
        )
        if repl is None:
            out.append(
                {
                    "from_symbol": h["symbol"],
                    "from_upside_pct": up,
                    "from_beta": h.get("beta"),
                    "industry": h["industry"],
                    "sector": sector or None,
                    "to_symbol": None,
                    "note": (
                        f"no industry/sector alternative with positive upside "
                        f"and β within ±{BETA_SWITCH_TOLERANCE} of {h.get('beta')}"
                    ),
                }
            )
            continue
        alt, level = repl
        out.append(
            {
                "from_symbol": h["symbol"],
                "from_upside_pct": up,
                "from_beta": h.get("beta"),
                "industry": h["industry"],
                "sector": sector or None,
                "to_symbol": alt.symbol,
                "to_industry": alt.industry,
                "to_sector": alt.sector or None,
                "to_upside_pct": round(float(alt.upside_pct), 1),
                "to_beta": round(alt.beta, 3),
                "switch_level": level,
            }
        )
    return out


def _user_pick_indices(stocks: list[Stock], user_picks: list[str]) -> list[int]:
    pick_set = set(user_picks)
    return [i for i, s in enumerate(stocks) if s.symbol in pick_set]


def optimize_weights(
    stocks: list[Stock],
    max_weight: float,
    *,
    min_weight: Optional[float] = None,
) -> Optional[np.ndarray]:
    """Maximize weighted upside subject to β in [TARGET_BETA_MIN, TARGET_BETA_MAX]."""
    n = len(stocks)
    if n == 0:
        return None
    betas = np.array([s.beta for s in stocks], dtype=float)
    upsides = np.array([s.upside_pct if s.upside_pct is not None else 0.0 for s in stocks], dtype=float)

    if min_weight is None and n <= 10:
        min_weight = max(0.05, 0.75 / n)
    floor = float(min_weight or 0.0)
    if floor * n > 1.0 + 1e-9:
        floor = 1.0 / n
    bounds = [(floor, max_weight)] * n

    x0 = _upside_weighted_start(n, upsides, bounds)

    def objective(w: np.ndarray) -> float:
        return float(-np.dot(w, upsides))

    constraints: list[dict] = [
        {"type": "eq", "fun": lambda w: np.sum(w) - 1.0},
        {"type": "ineq", "fun": lambda w: float(np.dot(w, betas) - TARGET_BETA_MIN)},
        {"type": "ineq", "fun": lambda w: float(TARGET_BETA_MAX - np.dot(w, betas))},
    ]

    res = minimize(objective, x0, method="SLSQP", bounds=bounds, constraints=constraints, options={"maxiter": 5000})
    if res.x is None:
        return None
    w = np.array(res.x, dtype=float)
    for i, (lo, hi) in enumerate(bounds):
        w[i] = float(np.clip(w[i], lo, hi))
    total = float(w.sum())
    if total <= 0:
        return None
    w = w / total
    if not _portfolio_beta_in_band(float(np.dot(w, betas))):
        return None
    return w


def _pick_max_weight() -> float:
    return PICK_MAX_WEIGHT


def _pick_auto_max_weight() -> float:
    """Max weight per auto name (Sharpe ≥ 1 tier)."""
    return AUTO_WEIGHT_MAX_HIGH


def _pick_weight_meta() -> dict:
    return {
        "pick_max_weight_pct": round(PICK_MAX_WEIGHT * 100, 1),
        "auto_max_weight_pct": round(AUTO_WEIGHT_MAX_HIGH * 100, 1),
        "auto_min_weight_pct_low_sharpe": round(AUTO_WEIGHT_MIN_LOW * 100, 1),
        "auto_max_weight_pct_low_sharpe": round(AUTO_WEIGHT_MAX_LOW * 100, 1),
        "auto_min_weight_pct_high_sharpe": round(AUTO_WEIGHT_MIN_HIGH * 100, 1),
        "auto_high_sharpe_threshold": AUTO_HIGH_SHARPE_THRESHOLD,
        "pick_auto_weight_gap_pct": round(PICK_AUTO_WEIGHT_GAP * 100, 1),
    }


def _auto_weight_bounds_for_sharpe(sharpe: Optional[float]) -> tuple[float, float]:
    if sharpe is not None and math.isfinite(sharpe) and sharpe >= AUTO_HIGH_SHARPE_THRESHOLD:
        return AUTO_WEIGHT_MIN_HIGH, AUTO_WEIGHT_MAX_HIGH
    return AUTO_WEIGHT_MIN_LOW, AUTO_WEIGHT_MAX_LOW


def _target_auto_weight_from_sharpe(sharpe: Optional[float]) -> float:
    lo, hi = _auto_weight_bounds_for_sharpe(sharpe)
    if sharpe is None or not math.isfinite(sharpe):
        return lo
    s = float(sharpe)
    if s >= AUTO_HIGH_SHARPE_THRESHOLD:
        t = min(1.0, max(0.0, s - AUTO_HIGH_SHARPE_THRESHOLD))
        return lo + t * (hi - lo)
    t = min(1.0, max(0.0, s))
    return lo + t * (hi - lo)


def _auto_weight_bounds_arrays(
    stocks: list[Stock], auto_idx: list[int]
) -> tuple[np.ndarray, np.ndarray]:
    mins = np.array([_auto_weight_bounds_for_sharpe(stocks[i].sharpe_ratio)[0] for i in auto_idx])
    maxs = np.array([_auto_weight_bounds_for_sharpe(stocks[i].sharpe_ratio)[1] for i in auto_idx])
    return mins, maxs


def _assign_auto_weights_by_sharpe(
    stocks: list[Stock],
    auto_idx: list[int],
    auto_budget: float,
) -> np.ndarray:
    """Spread auto budget across names; higher Sharpe → higher weight within tier bounds."""
    m = len(auto_idx)
    if m == 0 or auto_budget <= 0:
        return np.array([], dtype=float)
    targets = np.array([_target_auto_weight_from_sharpe(stocks[i].sharpe_ratio) for i in auto_idx])
    mins, maxs = _auto_weight_bounds_arrays(stocks, auto_idx)
    w = np.clip(targets, mins, maxs)
    total = float(w.sum())

    # Add slack to highest-Sharpe names first (stay within tier caps).
    if total + 1e-9 < auto_budget:
        slack = auto_budget - total
        order = sorted(
            range(m),
            key=lambda j: (
                float(stocks[auto_idx[j]].sharpe_ratio or -999.0),
                float(targets[j]),
            ),
            reverse=True,
        )
        for j in order:
            if slack <= 1e-9:
                break
            room = float(maxs[j] - w[j])
            if room <= 1e-12:
                continue
            add = min(room, slack)
            w[j] += add
            slack -= add

    # Trim from lowest-Sharpe names first (stay above tier floors).
    total = float(w.sum())
    if total > auto_budget + 1e-9:
        excess = total - auto_budget
        order = sorted(
            range(m),
            key=lambda j: (
                float(stocks[auto_idx[j]].sharpe_ratio or -999.0),
                float(targets[j]),
            ),
        )
        for j in order:
            if excess <= 1e-9:
                break
            reducible = float(w[j] - mins[j])
            if reducible <= 1e-12:
                continue
            cut = min(reducible, excess)
            w[j] -= cut
            excess -= cut

    return w


def _min_auto_fill_count(n_picks: int) -> int:
    """Fewest auto names needed to deploy the auto budget at tier caps."""
    pick_cap = PICK_MAX_WEIGHT
    auto_budget = 1.0 - n_picks * pick_cap
    if auto_budget <= 1e-9:
        return 0
    # Plan for low-Sharpe tier (max 8% each) so budget can always deploy.
    if AUTO_WEIGHT_MAX_LOW <= 1e-9:
        return 10**9
    return int(math.ceil(auto_budget / AUTO_WEIGHT_MAX_LOW))


def _effective_auto_cap(auto_budget: float, n_auto: int) -> float:
    """Per-name auto cap; rises when slot-limited so the full auto budget still deploys."""
    ideal = _pick_auto_max_weight()
    if n_auto <= 0:
        return ideal
    per_slot = auto_budget / n_auto
    return max(ideal, per_slot)


def resolve_pick_fill_plan(
    n_picks: int,
    *,
    size: int,
    fill_override: Optional[int],
) -> tuple[int, int] | dict:
    """Return ``(total_size, fill_count)`` where total_size includes manual picks."""
    pick_cap = PICK_MAX_WEIGHT
    pick_weight_total = n_picks * pick_cap
    if pick_weight_total > 1.0 + 1e-9:
        return {
            "error": (
                f"too many picks at {pick_cap * 100:.0f}% cap "
                f"({n_picks} picks = {pick_weight_total * 100:.0f}% > 100%)"
            ),
        }

    auto_budget = 1.0 - pick_weight_total
    if auto_budget <= 1e-9:
        return n_picks, 0

    min_auto = _min_auto_fill_count(n_picks)
    max_auto_slots = MAX_PICK_PORTFOLIO_SIZE - n_picks
    if max_auto_slots < 1:
        return {
            "error": (
                f"too many manual picks ({n_picks}) for {MAX_PICK_PORTFOLIO_SIZE} total slots "
                f"(need at least 1 auto-fill slot)."
            ),
        }

    if fill_override is not None:
        if fill_override == 0:
            return n_picks, 0
        fill_count = fill_override
        total = n_picks + fill_count
    else:
        fill_count = min(min_auto, max_auto_slots, max(0, size - n_picks))
        total = n_picks + fill_count

    if total < MIN_PICK_PORTFOLIO_SIZE or total > MAX_PICK_PORTFOLIO_SIZE:
        return {
            "error": (
                f"portfolio size must be {MIN_PICK_PORTFOLIO_SIZE}–{MAX_PICK_PORTFOLIO_SIZE} total "
                f"including your picks (got {total})."
            ),
        }
    if fill_count < 1:
        return {
            "error": (
                f"need at least 1 auto-fill slot ({n_picks} picks + auto = {total} total, "
                f"max {MAX_PICK_PORTFOLIO_SIZE})."
            ),
        }
    if fill_count > max_auto_slots:
        return {
            "error": (
                f"only {max_auto_slots} auto-fill slots available "
                f"({n_picks} picks + {max_auto_slots} auto = {MAX_PICK_PORTFOLIO_SIZE} total)."
            ),
        }

    per_slot = auto_budget / fill_count
    if per_slot > AUTO_WEIGHT_MAX_HIGH + 1e-6:
        return {
            "error": (
                f"with {n_picks} picks + {fill_count} auto-fill ({total} total slots), "
                f"auto needs {per_slot * 100:.1f}% per name but auto max is "
                f"{AUTO_WEIGHT_MAX_HIGH * 100:.0f}%. Use fewer picks or more auto slots."
            ),
            "total_slots": total,
            "max_portfolio_size": MAX_PICK_PORTFOLIO_SIZE,
        }
    return total, fill_count


def _nudge_portfolio_beta_into_band(
    w: np.ndarray,
    betas: np.ndarray,
    auto_idx: list[int],
    auto_cap: float,
    *,
    auto_caps: Optional[np.ndarray] = None,
    auto_mins: Optional[np.ndarray] = None,
    max_iter: int = 200,
) -> np.ndarray:
    """Shift auto weight toward higher/lower β names until portfolio β is in band."""
    w = np.array(w, dtype=float)
    if not auto_idx:
        return w

    def cap_for(i: int, j: int) -> float:
        if auto_caps is not None:
            return float(auto_caps[j])
        return auto_cap

    def min_for(i: int, j: int) -> float:
        if auto_mins is not None:
            return float(auto_mins[j])
        return 0.0

    idx_map = {i: j for j, i in enumerate(auto_idx)}

    for _ in range(max_iter):
        port_beta = float(np.dot(w, betas))
        if _portfolio_beta_in_band(port_beta):
            return w
        if port_beta < TARGET_BETA_MIN:
            need = TARGET_BETA_MIN - port_beta
            best: Optional[tuple[float, int, int]] = None
            for lo in auto_idx:
                if w[lo] <= min_for(lo, idx_map[lo]) + 1e-9:
                    continue
                for hi in auto_idx:
                    if lo == hi or betas[hi] <= betas[lo]:
                        continue
                    delta = float(betas[hi] - betas[lo])
                    transfer = min(
                        need / delta,
                        w[lo] - min_for(lo, idx_map[lo]),
                        cap_for(hi, idx_map[hi]) - w[hi],
                    )
                    if transfer <= 1e-9:
                        continue
                    if best is None or transfer > best[0]:
                        best = (transfer, lo, hi)
            if best is None:
                break
            transfer, lo, hi = best
            w[lo] -= transfer
            w[hi] += transfer
            continue
        need = port_beta - TARGET_BETA_MAX
        best = None
        for hi in auto_idx:
            if w[hi] <= min_for(hi, idx_map[hi]) + 1e-9:
                continue
            for lo in auto_idx:
                if lo == hi or betas[lo] >= betas[hi]:
                    continue
                delta = float(betas[hi] - betas[lo])
                transfer = min(
                    need / delta,
                    w[hi] - min_for(hi, idx_map[hi]),
                    cap_for(lo, idx_map[lo]) - w[lo],
                )
                if transfer <= 1e-9:
                    continue
                if best is None or transfer > best[0]:
                    best = (transfer, hi, lo)
        if best is None:
            break
        transfer, hi, lo = best
        w[hi] -= transfer
        w[lo] += transfer
    return w


def optimize_pick_portfolio_weights(
    stocks: list[Stock],
    user_picks: list[str],
    max_weight: float = MAX_WEIGHT,
) -> Optional[np.ndarray]:
    """
    Phase 1: each manual pick at ``PICK_MAX_WEIGHT`` (10%).
    Phase 2: auto names weighted by Sharpe tier (≥1 → 8–10%, <1 → 5–8%), β in 0.5–1.25.
    """
    n = len(stocks)
    pick_idx = _user_pick_indices(stocks, user_picks)
    if not pick_idx:
        return optimize_weights(stocks, max_weight)

    auto_idx = [i for i in range(n) if i not in set(pick_idx)]
    pick_cap = PICK_MAX_WEIGHT
    betas = np.array([s.beta for s in stocks], dtype=float)

    w = np.zeros(n, dtype=float)
    for i in pick_idx:
        w[i] = pick_cap
    pick_sum = float(w.sum())
    if pick_sum > 1.0 + 1e-9:
        scale = 1.0 / pick_sum
        for i in pick_idx:
            w[i] = pick_cap * scale
        pick_sum = 1.0

    auto_budget = 1.0 - pick_sum
    if not auto_idx or auto_budget <= 1e-9:
        return w if _portfolio_beta_in_band(float(np.dot(w, betas))) else None

    auto_mins, auto_maxs = _auto_weight_bounds_arrays(stocks, auto_idx)
    auto_cap = float(np.max(auto_maxs))
    x = _assign_auto_weights_by_sharpe(stocks, auto_idx, auto_budget)
    for j, i in enumerate(auto_idx):
        w[i] = float(x[j])

    w = _nudge_portfolio_beta_into_band(
        w, betas, auto_idx, auto_cap, auto_caps=auto_maxs, auto_mins=auto_mins
    )
    port_beta = float(np.dot(w, betas))
    if not _portfolio_beta_in_band(port_beta):
        return None
    for j, i in enumerate(auto_idx):
        if w[i] > auto_maxs[j] + 1e-5 or w[i] + 1e-5 < auto_mins[j]:
            return None
    if any(w[i] >= pick_cap - 1e-6 for i in auto_idx):
        return None
    return w


def _fallback_pick_portfolio_weights(
    n: int,
    pick_idx: list[int],
    auto_idx: list[int],
    pick_cap: float,
    auto_cap: float,
    auto_budget: float,
    upsides: Optional[np.ndarray] = None,
    stocks: Optional[list[Stock]] = None,
) -> np.ndarray:
    """Assign picks at cap; spread auto budget by Sharpe tier."""
    w = np.zeros(n, dtype=float)
    for i in pick_idx:
        w[i] = pick_cap
    if auto_idx and auto_budget > 0 and stocks is not None:
        x = _assign_auto_weights_by_sharpe(stocks, auto_idx, auto_budget)
        for j, i in enumerate(auto_idx):
            w[i] = float(x[j])
    elif auto_idx and auto_budget > 0:
        each = min(auto_cap, auto_budget / len(auto_idx))
        for i in auto_idx:
            w[i] = each
    total = float(w.sum())
    if total <= 0:
        return np.full(n, 1.0 / n)
    return w


def apply_auto_filler_switches(
    portfolio_stocks: list[Stock],
    weights: np.ndarray,
    auto_filled: set[str],
    universe: list[Stock],
    max_weight: float,
    user_picks: Optional[list[str]] = None,
) -> tuple[list[Stock], np.ndarray, list[dict]]:
    """Swap auto-filled legs below min upside for same-industry/sector names ≥ min upside."""
    stocks = list(portfolio_stocks)
    applied: list[dict] = []
    portfolio_syms = {s.symbol for s in stocks}

    changed = True
    while changed:
        changed = False
        for i, s in enumerate(stocks):
            if s.symbol not in auto_filled:
                continue
            if _meets_min_upside(s):
                continue
            repl = best_replacement_alternative(
                universe,
                industry=s.industry,
                sector=s.sector,
                exclude=portfolio_syms,
                reference_beta=s.beta,
                min_upside_pct=MIN_UPSIDE_PCT,
            )
            if repl is None:
                continue
            alt, level = repl
            applied.append(
                {
                    "from_symbol": s.symbol,
                    "from_upside_pct": round(float(s.upside_pct), 1),
                    "to_symbol": alt.symbol,
                    "to_upside_pct": round(float(alt.upside_pct), 1),
                    "industry": s.industry,
                    "sector": s.sector,
                    "to_industry": alt.industry,
                    "switch_level": level,
                    "auto_applied": True,
                }
            )
            portfolio_syms.discard(s.symbol)
            portfolio_syms.add(alt.symbol)
            stocks[i] = alt
            changed = True
            break

    if user_picks:
        new_w = optimize_pick_portfolio_weights(stocks, user_picks, max_weight)
    else:
        new_w = optimize_weights(stocks, max_weight=max_weight)
    if new_w is not None:
        weights = new_w
    return stocks, weights, applied


def prefer_famous_auto_fillers(
    portfolio_stocks: list[Stock],
    weights: np.ndarray,
    auto_filled: set[str],
    universe: list[Stock],
    max_weight: float,
    famous_eligible: tuple[str, ...],
    user_picks: Optional[list[str]] = None,
) -> tuple[list[Stock], np.ndarray, list[dict], set[str]]:
    """Swap non-famous auto-filled legs for famous names with similar β and upside ≥ min threshold."""
    stocks = list(portfolio_stocks)
    applied: list[dict] = []
    portfolio_syms = {s.symbol for s in stocks}
    by_sym = {s.symbol: s for s in universe}

    changed = True
    while changed:
        changed = False
        for i, s in enumerate(stocks):
            if s.symbol not in auto_filled or s.famous:
                continue
            best: Optional[tuple[tuple[float, float], Stock]] = None
            for sym in famous_eligible:
                if sym in portfolio_syms:
                    continue
                alt = by_sym.get(sym)
                if alt is None or not _meets_min_upside(alt):
                    continue
                if not _beta_within_switch_band(alt.beta, s.beta, BETA_SWITCH_TOLERANCE):
                    continue
                if float(alt.upside_pct) < float(s.upside_pct or 0):
                    continue  # never swap to lower upside
                score = (float(alt.upside_pct), -abs(alt.beta - s.beta))
                if best is None or score > best[0]:
                    best = (score, alt)
            if best is None:
                continue
            alt = best[1]
            trial = list(stocks)
            trial[i] = alt
            if user_picks:
                new_w = optimize_pick_portfolio_weights(trial, user_picks, max_weight)
            else:
                new_w = optimize_weights(trial, max_weight=max_weight)
            if new_w is None:
                continue
            if user_picks:
                auto_idx = [i for i, s in enumerate(trial) if s.symbol not in set(user_picks)]
                if any(new_w[i] < MIN_HOLDING_WEIGHT for i in auto_idx):
                    continue
            applied.append(
                {
                    "from_symbol": s.symbol,
                    "from_beta": round(s.beta, 3),
                    "from_upside_pct": round(float(s.upside_pct or 0), 1),
                    "to_symbol": alt.symbol,
                    "to_beta": round(alt.beta, 3),
                    "to_upside_pct": round(float(alt.upside_pct), 1),
                    "auto_applied": True,
                }
            )
            auto_filled.discard(s.symbol)
            auto_filled.add(alt.symbol)
            portfolio_syms.discard(s.symbol)
            portfolio_syms.add(alt.symbol)
            stocks = trial
            weights = new_w
            changed = True
            break

    return stocks, weights, applied, auto_filled


def prune_dust_holdings(
    portfolio_stocks: list[Stock],
    weights: np.ndarray,
    auto_filled: set[str],
    *,
    max_weight: float,
    user_picks: list[str],
) -> tuple[list[Stock], np.ndarray, set[str], list[str]]:
    """Drop auto-fill legs below ``MIN_HOLDING_WEIGHT`` and re-optimize."""
    stocks = list(portfolio_stocks)
    w = np.array(weights, dtype=float)
    removed: list[str] = []
    pick_set = set(user_picks)

    while True:
        dust = [
            i
            for i, s in enumerate(stocks)
            if s.symbol in auto_filled and w[i] < MIN_HOLDING_WEIGHT
        ]
        if not dust:
            break
        keep = [i for i in range(len(stocks)) if i not in dust]
        if len(keep) <= len(pick_set):
            break
        for i in sorted(dust, reverse=True):
            removed.append(stocks[i].symbol)
            auto_filled.discard(stocks[i].symbol)
        stocks = [stocks[i] for i in keep]
        w = np.array([w[i] for i in keep], dtype=float)
        new_w = optimize_pick_portfolio_weights(stocks, user_picks, max_weight)
        if new_w is None:
            break
        w = new_w

    return stocks, w, auto_filled, removed


def apply_admin_override_swaps(
    portfolio_stocks: list[Stock],
    weights: np.ndarray,
    universe: list[Stock],
    auto_set: set[str],
    *,
    max_weight: float,
    user_picks: list[str],
) -> tuple[list[Stock], np.ndarray, set[str], list[dict]]:
    """Swap auto-fill legs that match admin disqualifications to their replacements."""
    if not SYMBOL_OVERRIDES:
        return portfolio_stocks, weights, auto_set, []
    by_sym = {s.symbol: s for s in universe}
    pick_set = set(user_picks)
    applied: list[dict] = []
    stocks = list(portfolio_stocks)
    w = np.array(weights, dtype=float)

    i = 0
    while i < len(stocks):
        s = stocks[i]
        if s.symbol not in SYMBOL_OVERRIDES or s.symbol in pick_set:
            i += 1
            continue
        repl = replacement_for_disqualified(s.symbol)
        if not repl:
            i += 1
            continue
        repl = _resolve_override_chain(repl)
        if repl == s.symbol or repl in pick_set:
            i += 1
            continue
        if repl not in by_sym:
            applied.append(
                {
                    "from_symbol": s.symbol,
                    "to_symbol": repl,
                    "note": "replacement not in universe",
                    "applied": False,
                }
            )
            i += 1
            continue

        existing = next((j for j, x in enumerate(stocks) if x.symbol == repl), None)
        if existing is not None and existing != i:
            w[existing] = float(w[existing] + w[i])
            applied.append(
                {
                    "from_symbol": s.symbol,
                    "to_symbol": repl,
                    "merged_weight_pct": round(float(w[existing]) * 100.0, 2),
                    "applied": True,
                }
            )
            auto_set.discard(s.symbol)
            auto_set.add(repl)
            stocks.pop(i)
            w = np.delete(w, i)
            continue

        stocks[i] = by_sym[repl]
        auto_set.discard(s.symbol)
        auto_set.add(repl)
        applied.append({"from_symbol": s.symbol, "to_symbol": repl, "applied": True})
        i += 1

    new_w = optimize_pick_portfolio_weights(stocks, user_picks, max_weight)
    if new_w is not None:
        w = new_w
    return stocks, w, auto_set, applied


def finalize_pick_portfolio(
    portfolio_stocks: list[Stock],
    weights: np.ndarray,
    universe: list[Stock],
    *,
    max_weight: float,
    user_picks: list[str],
    auto_filled_syms: list[str],
    extra: dict,
    famous_eligible: tuple[str, ...],
) -> dict:
    auto_set = set(auto_filled_syms)
    stocks, weights, auto_swaps = apply_auto_filler_switches(
        portfolio_stocks, weights, auto_set, universe, max_weight, user_picks
    )
    famous_swaps: list[dict] = []
    if not user_picks:
        stocks, weights, famous_swaps, auto_set = prefer_famous_auto_fillers(
            stocks, weights, auto_set, universe, max_weight, famous_eligible, user_picks
        )
    stocks, weights, auto_set, pruned = prune_dust_holdings(
        stocks,
        weights,
        auto_set,
        max_weight=max_weight,
        user_picks=user_picks,
    )
    stocks, weights, auto_set, override_swaps = apply_admin_override_swaps(
        stocks,
        weights,
        universe,
        auto_set,
        max_weight=max_weight,
        user_picks=user_picks,
    )
    summary = portfolio_summary(stocks, weights, user_picks=user_picks)
    portfolio_syms = {s.symbol for s in stocks}
    switches = suggest_industry_switches(universe, summary["holdings"], portfolio_syms)
    result_extra = {**extra, "auto_filled": [s.symbol for s in stocks if s.symbol in auto_set]}
    if pruned:
        result_extra["pruned_dust"] = pruned
    if override_swaps:
        result_extra["admin_override_swaps"] = override_swaps
    return {
        **result_extra,
        **summary,
        "auto_switches_applied": auto_swaps,
        "famous_swaps_applied": famous_swaps,
        "switch_suggestions": switches,
    }


def complete_portfolio_from_picks(
    universe: list[Stock],
    picks: list[str],
    *,
    fill_count: int = DEFAULT_FILL_COUNT,
    max_weight: float = MAX_WEIGHT,
    famous_eligible: tuple[str, ...],
) -> dict:
    """
    User picks 1–4 anchors from ``FAMOUS_STOCKS``; auto-select ``fill_count`` diversified
    names from the wider universe with β in 0.5–1.25 and maximum upside.
    """
    manual_set = set(famous_eligible)
    not_famous = [p for p in picks if p not in manual_set]
    if not_famous:
        return {
            "error": (
                f"manual picks must be from the 16 famous stocks with ≥{FAMOUS_MIN_UPSIDE_PCT:.0f}% upside: "
                + ", ".join(not_famous)
            ),
            "allowed_picks": list(famous_eligible),
            "famous_stocks": list(FAMOUS_STOCKS),
            "famous_min_upside_pct": FAMOUS_MIN_UPSIDE_PCT,
            "max_manual_picks": MAX_MANUAL_PICKS,
        }

    by_sym = {s.symbol: s for s in universe}
    disqualified_picks = [p for p in picks if is_symbol_disqualified(p)]
    if disqualified_picks:
        return {
            "error": (
                f"admin-disqualified symbols cannot be picked: {', '.join(disqualified_picks)}"
            ),
            "disqualified_picks": disqualified_picks,
            "allowed_picks": list(famous_eligible),
        }
    missing = [p for p in picks if p not in by_sym]
    if missing:
        return {
            "error": f"not in FvIndustries valuations: {', '.join(missing)}",
            "allowed_picks": list(famous_eligible),
            "famous_min_upside_pct": FAMOUS_MIN_UPSIDE_PCT,
        }

    anchors = [by_sym[p] for p in picks]
    anchor_industries = {a.industry for a in anchors}
    anchor_sectors = {a.sector for a in anchors if a.sector}

    if fill_count == 0:
        portfolio_stocks = anchors
        weights = optimize_pick_portfolio_weights(
            portfolio_stocks, picks, max_weight
        )
        if weights is None:
            cap = PICK_MAX_WEIGHT
            weights = np.array([min(cap, 1.0 / len(anchors))] * len(anchors))
            weights = weights / weights.sum()
        anchor_beta_sum = sum(a.beta for a in anchors)
        return finalize_pick_portfolio(
            portfolio_stocks,
            weights,
            universe,
            max_weight=max_weight,
            user_picks=picks,
            auto_filled_syms=[],
            extra={
                "mode": "pick_and_fill",
                "target_beta_min": TARGET_BETA_MIN,
                "target_beta_max": TARGET_BETA_MAX,
                **_pick_weight_meta(),
                "user_picks": picks,
                "auto_filled": [],
                "required_filler_beta_avg": None,
                "anchor_beta_avg": round(anchor_beta_sum / len(anchors), 3),
                "famous_stocks": list(FAMOUS_STOCKS),
                "max_manual_picks": MAX_MANUAL_PICKS,
                "portfolio_size": len(anchors),
                "famous_min_upside_pct": FAMOUS_MIN_UPSIDE_PCT,
            },
            famous_eligible=famous_eligible,
        )

    total_names = len(anchors) + fill_count
    if total_names < 2:
        return {"error": "need at least 2 names total (picks + fill)"}

    anchor_beta_sum = sum(a.beta for a in anchors)
    # Equal-weight portfolio: avg beta = (sum anchor betas + sum filler betas) / total_names.
    required_filler_beta_avg = (FILLER_BETA_AIM * total_names - anchor_beta_sum) / fill_count

    b_min = min(s.beta for s in universe)
    b_max = max(s.beta for s in universe)
    if required_filler_beta_avg < b_min - 0.05 or required_filler_beta_avg > b_max + 0.05:
        return {
            "error": (
                f"cannot hit β={TARGET_BETA_MIN}–{TARGET_BETA_MAX} with {len(anchors)} picks + {fill_count} fillers "
                f"(need filler avg β≈{required_filler_beta_avg:.2f}, universe {b_min:.2f}–{b_max:.2f})"
            ),
            "anchors": [{"symbol": a.symbol, "beta": a.beta} for a in anchors],
            "required_filler_beta_avg": round(required_filler_beta_avg, 3),
        }

    pick_syms = {a.symbol for a in anchors}
    manual_famous = set(FAMOUS_STOCKS)
    candidates = [
        s
        for s in universe
        if s.symbol not in pick_syms
        and s.symbol not in manual_famous
        and not is_symbol_disqualified(s.symbol)
        and _meets_min_upside(s)
    ]
    fillers = select_diversified_fillers(
        candidates,
        count=fill_count,
        target_avg_beta=required_filler_beta_avg,
        used_industries=anchor_industries,
        used_sectors=anchor_sectors,
    )
    if len(fillers) < fill_count:
        return {"error": f"only found {len(fillers)} filler candidates (wanted {fill_count})"}

    portfolio_stocks = anchors + fillers
    weights = optimize_pick_portfolio_weights(
        portfolio_stocks, picks, max_weight
    )
    if weights is None:
        pick_cap = PICK_MAX_WEIGHT
        auto_cap = _pick_auto_max_weight()
        pick_idx = _user_pick_indices(portfolio_stocks, picks)
        auto_idx = [i for i in range(len(portfolio_stocks)) if i not in set(pick_idx)]
        auto_budget = 1.0 - len(pick_idx) * pick_cap
        if auto_budget < 0:
            auto_budget = 0.0
        weights = _fallback_pick_portfolio_weights(
            len(portfolio_stocks),
            pick_idx,
            auto_idx,
            pick_cap,
            auto_cap,
            auto_budget,
            stocks=portfolio_stocks,
        )
        auto_mins, auto_maxs = _auto_weight_bounds_arrays(portfolio_stocks, auto_idx)
        betas = np.array([s.beta for s in portfolio_stocks], dtype=float)
        weights = _nudge_portfolio_beta_into_band(
            weights, betas, auto_idx, auto_cap, auto_caps=auto_maxs, auto_mins=auto_mins
        )

    return finalize_pick_portfolio(
        portfolio_stocks,
        weights,
        universe,
        max_weight=max_weight,
        user_picks=picks,
        auto_filled_syms=[f.symbol for f in fillers],
        extra={
            "mode": "pick_and_fill",
            "target_beta_min": TARGET_BETA_MIN,
            "target_beta_max": TARGET_BETA_MAX,
            **_pick_weight_meta(),
            "user_picks": picks,
            "auto_filled": [f.symbol for f in fillers],
            "required_filler_beta_avg": round(required_filler_beta_avg, 3),
            "anchor_beta_avg": round(anchor_beta_sum / len(anchors), 3),
            "famous_stocks": list(FAMOUS_STOCKS),
            "max_manual_picks": MAX_MANUAL_PICKS,
            "portfolio_size": total_names,
            "famous_min_upside_pct": FAMOUS_MIN_UPSIDE_PCT,
        },
        famous_eligible=famous_eligible,
    )


