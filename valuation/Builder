def portfolio_summary(
    stocks: list[Stock],
    weights: np.ndarray,
    *,
    user_picks: Optional[list[str]] = None,
) -> dict:
    betas = np.array([s.beta for s in stocks])
    upsides = np.array([s.upside_pct if s.upside_pct is not None else 0.0 for s in stocks])
    sharpes = np.array([s.sharpe_ratio for s in stocks])
    pick_set = set(user_picks or [])
    holdings = []
    user_pick_weight = 0.0
    for s, w in zip(stocks, weights):
        if w <= MIN_HOLDING_WEIGHT - 1e-9:
            continue
        if s.symbol in pick_set:
            user_pick_weight += float(w)
        holdings.append(
            {
                "symbol": s.symbol,
                "weight_pct": round(float(w) * 100.0, 2),
                "beta": round(s.beta, 3),
                "upside_pct": round(s.upside_pct, 1) if s.upside_pct is not None else None,
                "sharpe_ratio": round(s.sharpe_ratio, 3) if s.sharpe_ratio is not None else None,
                "price": round(s.price, 2) if s.price is not None else None,
                "fair_value": round(s.fair_value, 2) if s.fair_value is not None else None,
                "industry": s.industry,
                "sector": s.sector or None,
                "famous": s.famous,
                "high_upside": s.high_upside,
                "user_pick": s.symbol in pick_set,
            }
        )
    holdings.sort(key=lambda h: h["weight_pct"], reverse=True)
    port_sharpe = float(np.dot(weights, np.nan_to_num(sharpes, nan=0.0)))
    out = {
        "holdings_count": len(holdings),
        "portfolio_beta": round(float(np.dot(weights, betas)), 4),
        "portfolio_upside_pct": round(float(np.dot(weights, upsides)), 2),
        "portfolio_sharpe_weighted": round(port_sharpe, 3),
        "holdings": holdings,
        "beta_band": {"min": TARGET_BETA_MIN, "max": TARGET_BETA_MAX},
        "built_at": datetime.now(timezone.utc).isoformat(),
    }
    if user_picks:
        out["user_picks"] = list(user_picks)
        out["user_pick_weight_pct"] = round(user_pick_weight * 100.0, 2)
    return out


def build_portfolios(
    stocks: list[Stock],
    max_weight: float,
    famous_eligible: tuple[str, ...],
) -> dict:
    betas = [s.beta for s in stocks]
    b_min, b_max = min(betas), max(betas)
    universe_meta = {
        "symbols": len(stocks),
        "famous_count": sum(1 for s in stocks if s.famous),
        "high_upside_count": sum(1 for s in stocks if s.high_upside),
        "beta_min": round(b_min, 3),
        "beta_max": round(b_max, 3),
        "beta_mean": round(sum(betas) / len(betas), 3),
        "target_beta_min": TARGET_BETA_MIN,
        "target_beta_max": TARGET_BETA_MAX,
        "min_upside_threshold_pct": MIN_UPSIDE_PCT,
        "famous_min_upside_pct": FAMOUS_MIN_UPSIDE_PCT,
        "famous_symbols": list(famous_eligible),
        "famous_stocks": list(FAMOUS_STOCKS),
        "famous_candidates": list(FAMOUS_CANDIDATES),
    }
    w = optimize_weights(stocks, max_weight=max_weight)
    entry: dict = {
        "target_beta_min": TARGET_BETA_MIN,
        "target_beta_max": TARGET_BETA_MAX,
    }
    if w is None:
        entry["error"] = (
            f"infeasible for β={TARGET_BETA_MIN}–{TARGET_BETA_MAX} "
            f"(universe beta range {b_min:.2f}–{b_max:.2f})"
        )
        return {"universe": universe_meta, "portfolio": entry}
    entry.update(portfolio_summary(stocks, w))
    return {"universe": universe_meta, "portfolio": entry}


