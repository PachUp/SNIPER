@dataclass(frozen=True)
class Stock:
    symbol: str
    beta: float
    upside_pct: Optional[float]
    price: Optional[float]
    fair_value: Optional[float]
    industry: str
    sector: str
    famous: bool
    high_upside: bool
    sharpe_ratio: Optional[float] = None


def load_famous_stocks_file(path: Path) -> tuple[str, ...]:
    """Load admin famous list: ``{"stocks": [{"symbol": "DIS", "name": "..."}]}`` or ``{"symbols": ["DIS", ...]}``."""
    data = json.loads(path.read_text(encoding="utf-8"))
    raw = data.get("stocks") or data.get("symbols") or []
    if not isinstance(raw, list) or not raw:
        raise ValueError(f"no stocks in {path}")
    if isinstance(raw[0], dict):
        return tuple(str(item["symbol"]).upper() for item in raw if item.get("symbol"))
    return tuple(str(sym).upper() for sym in raw)


def apply_famous_stocks_override(symbols: tuple[str, ...]) -> None:
    global FAMOUS_STOCKS, FAMOUS_CANDIDATES
    FAMOUS_STOCKS = symbols
    FAMOUS_CANDIDATES = FAMOUS_STOCKS + FAMOUS_RESERVE


# Admin disqualifications: symbol → replacement (None = exclude only, no substitute).
SYMBOL_OVERRIDES: dict[str, Optional[str]] = {}


def load_symbol_overrides_file(path: Path) -> dict[str, Optional[str]]:
    """
    Load ``{"entries": [{"symbol": "AA", "replacement": "MPC", "note": "..."}]}``.
    ``replacement`` null/omitted = exclude from universe only.
    """
    data = json.loads(path.read_text(encoding="utf-8"))
    raw = data.get("entries") or []
    out: dict[str, Optional[str]] = {}
    if not isinstance(raw, list):
        return out
    for item in raw:
        if not isinstance(item, dict):
            continue
        sym = str(item.get("symbol", "")).upper().strip()
        if not sym:
            continue
        repl_raw = item.get("replacement")
        if repl_raw is None or repl_raw == "":
            out[sym] = None
        else:
            out[sym] = str(repl_raw).upper().strip()
    return out


def apply_symbol_overrides(overrides: dict[str, Optional[str]]) -> None:
    global SYMBOL_OVERRIDES
    SYMBOL_OVERRIDES = {k.upper(): (v.upper() if v else None) for k, v in overrides.items()}


def is_symbol_disqualified(sym: str) -> bool:
    return sym.upper() in SYMBOL_OVERRIDES


def replacement_for_disqualified(sym: str) -> Optional[str]:
    return SYMBOL_OVERRIDES.get(sym.upper())


def _resolve_override_chain(sym: str) -> str:
    """Follow replacement chain; stop if exclude-only or cycle."""
    seen: set[str] = set()
    cur = sym.upper()
    while cur in SYMBOL_OVERRIDES:
        if cur in seen:
            break
        seen.add(cur)
        nxt = SYMBOL_OVERRIDES[cur]
        if not nxt:
            return cur
        cur = nxt.upper()
    return cur


def load_sector_maps(universe_path: Path) -> tuple[dict[str, str], dict[str, str]]:
    """symbol → sector, finviz industry name → sector (from extracted_symbols JSON)."""
    symbol_to_sector: dict[str, str] = {}
    industry_to_sector: dict[str, str] = {}
    try:
        data = json.loads(universe_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return symbol_to_sector, industry_to_sector
    for sector, groups in (data.get("sectors") or {}).items():
        if not isinstance(groups, dict):
            continue
        for _gics_industry, finviz_groups in groups.items():
            if not isinstance(finviz_groups, dict):
                continue
            for finviz_industry, companies in finviz_groups.items():
                if finviz_industry:
                    industry_to_sector[str(finviz_industry)] = str(sector)
                if not isinstance(companies, list):
                    continue
                for c in companies:
                    if not isinstance(c, dict):
                        continue
                    sym = c.get("symbol")
                    if sym:
                        symbol_to_sector[str(sym).upper()] = str(sector)
                    orig = c.get("original_finviz_industry")
                    if orig:
                        industry_to_sector[str(orig)] = str(sector)
    return symbol_to_sector, industry_to_sector


def resolve_sector(
    symbol: str,
    industry: str,
    symbol_to_sector: dict[str, str],
    industry_to_sector: dict[str, str],
) -> str:
    return symbol_to_sector.get(symbol.upper()) or industry_to_sector.get(industry) or ""


def load_sharpe_map(sharpe_path: Path) -> dict[str, float]:
    """symbol → 1y Sharpe ratio (from ``all_stocks_sharpe_ratios.json``)."""
    out: dict[str, float] = {}
    try:
        data = json.loads(sharpe_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return out
    for row in data.get("stocks") or []:
        if not isinstance(row, dict):
            continue
        sym = row.get("symbol")
        sh = row.get("sharpe_ratio")
        if sym and isinstance(sh, (int, float)) and math.isfinite(float(sh)):
            out[str(sym).upper()] = float(sh)
    return out


def apply_sharpe_map(stocks: dict[str, Stock], sharpe_map: dict[str, float]) -> dict[str, Stock]:
    if not sharpe_map:
        return stocks
    out: dict[str, Stock] = {}
    for sym, s in stocks.items():
        sh = sharpe_map.get(s.symbol.upper())
        out[sym] = Stock(
            symbol=s.symbol,
            beta=s.beta,
            upside_pct=s.upside_pct,
            price=s.price,
            fair_value=s.fair_value,
            industry=s.industry,
            sector=s.sector,
            famous=s.famous,
            high_upside=s.high_upside,
            sharpe_ratio=sh,
        )
    return out


def _portfolio_beta_in_band(beta: float) -> bool:
    return TARGET_BETA_MIN - 1e-4 <= beta <= TARGET_BETA_MAX + 1e-4


def _upside_weighted_start(
    n: int,
    upsides: np.ndarray,
    bounds: list[tuple[float, float]],
) -> np.ndarray:
    raw = np.array([max(float(upsides[i]), 0.0) for i in range(n)], dtype=float)
    if float(raw.sum()) <= 0:
        raw = np.ones(n, dtype=float)
    x0 = raw / raw.sum()
    for i, (lo, hi) in enumerate(bounds):
        x0[i] = float(np.clip(x0[i], lo, hi))
    total = float(x0.sum())
    return x0 / total if total > 0 else np.full(n, 1.0 / n)


def _meets_famous_upside_bar(sym: str, all_stocks: dict[str, Stock]) -> bool:
    """True if upside ≥ 20%, or ticker is on the explicit exception list."""
    if sym in FAMOUS_UPSIDE_EXCEPTIONS:
        return sym in all_stocks
    s = all_stocks.get(sym)
    return (
        s is not None
        and s.upside_pct is not None
        and float(s.upside_pct) >= FAMOUS_MIN_UPSIDE_PCT
    )


def famous_eligible_symbols(all_stocks: dict[str, Stock]) -> tuple[str, ...]:
    """Any ``FAMOUS_CANDIDATES`` name with model upside ≥ ``FAMOUS_MIN_UPSIDE_PCT`` (or exception)."""
    return tuple(
        sym for sym in FAMOUS_CANDIDATES if _meets_famous_upside_bar(sym, all_stocks)
    )


def famous_manual_pick_symbols(all_stocks: dict[str, Stock]) -> tuple[str, ...]:
    """The 16 ``FAMOUS_STOCKS`` that currently meet the ≥20% upside manual-pick bar (or exception)."""
    return tuple(
        sym
        for sym in FAMOUS_STOCKS
        if not is_symbol_disqualified(sym)
        and _meets_famous_upside_bar(sym, all_stocks)
