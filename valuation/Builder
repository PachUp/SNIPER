        if not (MIN_PICK_PORTFOLIO_SIZE <= args.size <= MAX_PICK_PORTFOLIO_SIZE):
            print(
                f"Pick mode portfolio size must be {MIN_PICK_PORTFOLIO_SIZE}–{MAX_PICK_PORTFOLIO_SIZE} "
                f"(got {args.size}).",
                file=sys.stderr,
            )
            sys.exit(1)
        plan = resolve_pick_fill_plan(
            len(picks),
            size=args.size,
            fill_override=args.fill,
        )
        if isinstance(plan, dict):
            print(f"ERROR: {plan['error']}", file=sys.stderr)
            sys.exit(1)
        portfolio_size, fill_count = plan
        result = complete_portfolio_from_picks(
            universe,
            picks,
            fill_count=fill_count,
            max_weight=args.max_weight,
            famous_eligible=manual_eligible,
        )
        if "error" in result:
            if args.json_stdout:
                print(json.dumps(result), file=sys.stdout)
            else:
                print_pick_report(result)
            sys.exit(1)
        if args.json_stdout:
            print(json.dumps(result), file=sys.stdout)
            return
        print_pick_report(result)
        out = args.output or DEFAULT_FV_DIR / "portfolio_pick.json"
    else:
        result = build_portfolios(
            universe, max_weight=args.max_weight, famous_eligible=famous_eligible
        )
        print_report(result)
        out = args.output or DEFAULT_OUTPUT

    if out:
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(json.dumps(result, indent=2), encoding="utf-8")
        print(f"Wrote → {out}")


if __name__ == "__main__":
    main()
